FROM python:3.12-slim

ARG LAYA_VERSION=0.3.20
ARG TORCH_VERSION=2.14.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/home/laya/.cache/huggingface \
    TORCH_DISABLE_NATIVE_JIT=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir \
       --index-url https://download.pytorch.org/whl/cpu \
       "torch==${TORCH_VERSION}" \
    && pip install --no-cache-dir "laya[serve]==${LAYA_VERSION}" \
    && adduser --disabled-password --gecos "" --uid 10001 laya \
    && mkdir -p /home/laya/.cache/huggingface \
    && chown -R laya:laya /home/laya

USER laya

EXPOSE 8000

CMD ["laya-serve"]
