# Safe local development defaults
APP_NAME=Agentic Google Workspace Orchestrator
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Development-only infrastructure values; replace outside local development.
POSTGRES_DB=workspace_orchestrator
POSTGRES_USER=workspace
POSTGRES_PASSWORD=development-only-password
DATABASE_URL=postgresql+psycopg://workspace:development-only-password@localhost:5432/workspace_orchestrator
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_NAMESPACE=workspace-orchestrator
DEPENDENCY_TIMEOUT_SECONDS=2

# Google OAuth (replace with values from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Groq LLM provider (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_USER_TIMEZONE=Asia/Kolkata
DEFAULT_MEETING_DURATION_MINUTES=30

# Local retrieval and bounded background synchronization
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_TTL_SECONDS=3600
# Optional: trades slower API startup for avoiding first-query model loading.
EMBEDDING_WARMUP_ENABLED=false
INDEX_STALE_AFTER_MINUTES=15
SYNC_GMAIL_MAX_ITEMS=200
SYNC_CALENDAR_LOOKBACK_DAYS=30
SYNC_CALENDAR_LOOKAHEAD_DAYS=90
SYNC_DRIVE_MAX_ITEMS=200
SYNC_LOCK_TTL_SECONDS=900
